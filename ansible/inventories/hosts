# ------------------------------------------------------------------------------
# SECTION 1: STANDALONE MODE
# Used for: kind-playbook.yaml and standalone k3s-playbook.yaml
# ------------------------------------------------------------------------------

[standalone-masters]
# For standalone architecture, only one master/control-plane node is needed
k8s-master-machine ansible_host=127.0.0.1 ansible_port=6996 node_ip=192.168.56.99

[standalone-workers]
# You can have multiple worker nodes in standalone architecture
k8s-worker-machine-1 ansible_host=127.0.0.1 ansible_port=9669 node_ip=192.168.56.101

# Meta-group to aggregate all standalone nodes for playbook targeting
[standalone-all:children]
standalone-masters
standalone-workers

# ------------------------------------------------------------------------------
# SECTION 2: HIGH AVAILABILITY (HA) MODE
# Required by: k3s-ha-playbook.yaml
# ------------------------------------------------------------------------------

[ha_master_init]
# NOTICE [CRITICAL]: Exactly ONE node must be defined here. 
# This node bootstraps the etcd cluster and generates the cluster token.
k8s-master-machine ansible_host=127.0.0.1 ansible_port=6996 node_ip=192.168.56.99

[ha_master_join]
# Additional control-plane nodes that join the cluster initialized above.
k8s-worker-machine-1 ansible_host=127.0.0.1 ansible_port=9669 node_ip=192.168.56.101
k8s-worker-machine-2 ansible_host=127.0.0.1 ansible_port=9670 node_ip=192.168.56.102

[ha_worker]
# Dedicated agent/worker nodes for the HA cluster.

# ------------------------------------------------------------------------------
# SECTION 3: META-GROUPS (Children Groups)
# Purpose: Logical aggregation for playbook targeting.
# ------------------------------------------------------------------------------

# Aggregates all HA masters (init + join)
[ha_master:children]
ha_master_init
ha_master_join

# Aggregates the entire HA cluster
[ha_all:children]
ha_master
ha_worker

# ------------------------------------------------------------------------------
# SECTION 4: GLOBAL CONFIGURATION
# Variables applied to all nodes in the inventory.
# ------------------------------------------------------------------------------

[all:vars]
ansible_user=vagrant
ansible_connection=ssh
# Provide the path to your VM SSH key
ansible_ssh_private_key_file="~/.ssh/id_rsa"
# Speed up connections by disabling host key checking for local VMs
ansible_ssh_common_args='-o StrictHostKeyChecking=no'