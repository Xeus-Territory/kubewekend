# LGTM Testing - Environment Variables
# Copy this to .env and adjust as needed

# Database
DATABASE_URL=postgresql://appuser:apppassword@postgres:5432/lgtm_testing

# OpenTelemetry
# For local Docker Compose (sends to host machine where Alloy port-forward runs)
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
# For Kubernetes
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy-alloy.monitoring.svc.cluster.local:4317

OTEL_SERVICE_NAME=lgtm-testing-api
OTEL_ENVIRONMENT=development

# OTLP Metrics export (optional - requires Alloy with otelcol.exporter.prometheus
# or Prometheus with OTLP receiver enabled)
# Set to true when your collector can accept OTLP MetricsService
OTEL_METRICS_ENABLED=false

# Pyroscope
PYROSCOPE_SERVER_ADDRESS=http://host.docker.internal:4040
PYROSCOPE_ENABLED=false
